# Postgres
POSTGRES_USER=reconcilio
POSTGRES_PASSWORD=reconcilio
POSTGRES_DB=reconcilio
DATABASE_URL=postgresql+psycopg://reconcilio:reconcilio@postgres:5432/reconcilio

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
# Host the browser uses for presigned upload/download URLs — must be reachable
# from wherever you open the app, not just from inside the compose network.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reconcilio
MINIO_SECURE=false

# Auth
JWT_SECRET=please-change-this-in-.env
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Frontend
VITE_API_URL=http://localhost:8000
