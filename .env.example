# Postgres
POSTGRES_USER=reconcilio
POSTGRES_PASSWORD=reconcilio
POSTGRES_DB=reconcilio
DATABASE_URL=postgresql+psycopg://reconcilio:reconcilio@postgres:5432/reconcilio

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
# Host the browser uses for presigned upload/download URLs — must be reachable
# from wherever you open the app, not just from inside the compose network.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reconcilio
MINIO_SECURE=false

# Auth
JWT_SECRET=please-change-this-in-.env
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# AWS Textract (invoice/receipt + PDF bank-statement extraction)
# Read directly by boto3 from the process environment, not by this app's
# Settings class — with the api/worker services' `env_file: .env` in
# docker-compose, values here are enough. Running the backend directly on
# the host instead, `export` them in your shell (or `set -a && source
# backend/.env && set +a`) since pydantic-settings does not re-export .env
# values into os.environ for other libraries to pick up.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Textract's AnalyzeExpense API isn't available in every region — us-east-1
# is a safe default if you're unsure.
AWS_DEFAULT_REGION=us-east-1

# OpenRouter (LLM refinement pass for low-confidence Textract fields)
# Auto-detected by LiteLLM whenever the model string is prefixed
# "openrouter/" (see backend/app/extraction/llm.py) — same env-propagation
# caveat as above applies.
OPENROUTER_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8000
